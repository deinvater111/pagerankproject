#!/usr/bin/env bash
#PBS -N pagerank_weak256_1n
#PBS -l select=1:ncpus=64:mpiprocs=64:mem=128gb
#PBS -l place=excl
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
source "${PBS_O_WORKDIR}/scripts/vanda_common.sh"

result="results/raw/weak256_${PBS_JOBID}.csv"
repetitions="${REPETITIONS:-1}"
base_vertices="${BASE_VERTICES:-100000}"
edges_per_vertex="${EDGES_PER_VERTEX:-16}"

for ranks in 1 2 4 8 16 32 64; do
  vertices=$((base_vertices * ranks))
  graph="data/weak256_n${vertices}_k${edges_per_vertex}"
  for ((repeat=1; repeat<=repetitions; repeat++)); do
    echo "weak256 ranks=${ranks} vertices=${vertices} repeat=${repeat}"
    run_mpi "${ranks}" 1 bin/pagerank_hybrid \
      --graph "${graph}" \
      --partition vertices \
      --schedule static \
      --fixed-iterations 100 \
      --top-k 0 \
      --quiet \
      --output "${result}"
  done
done

echo "Weak-scaling 1-64 rank results: ${result}"
