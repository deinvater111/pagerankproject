#!/usr/bin/env bash
#PBS -N pagerank_strong256
#PBS -l select=4:ncpus=64:mpiprocs=64:mem=64gb
#PBS -l place=scatter:excl
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail
source "${PBS_O_WORKDIR}/scripts/vanda_common.sh"

result="results/raw/strong256_${PBS_JOBID}.csv"
repetitions="${REPETITIONS:-1}"

for partition in vertices edges; do
  for ((repeat=1; repeat<=repetitions; repeat++)); do
    echo "strong-256 partition=${partition} ranks=256 repeat=${repeat}"
    run_mpi_ppr 256 64 1 bin/pagerank_hybrid \
      --graph data/pokec_graph \
      --partition "${partition}" \
      --schedule static \
      --fixed-iterations 100 \
      --top-k 0 \
      --quiet \
      --output "${result}"
  done
done

echo "256-rank strong-scaling results: ${result}"
